# Cross-compile MSVC-ABI code (OptiScaler) on Linux: clang-cl + lld-link with the MSVC CRT and Windows SDK from xwin
# (xwin --accept-license splat --output ~/.xwin).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_C_COMPILER clang-cl)
set(CMAKE_CXX_COMPILER clang-cl)
set(CMAKE_LINKER lld-link)
set(CMAKE_RC_COMPILER llvm-rc)
set(CMAKE_AR llvm-lib)
set(CMAKE_MT llvm-mt)
set(XWIN $ENV{HOME}/.xwin CACHE PATH "xwin splat output")
set(XWIN_INCLUDES "/imsvc${XWIN}/crt/include /imsvc${XWIN}/sdk/include/ucrt /imsvc${XWIN}/sdk/include/um /imsvc${XWIN}/sdk/include/shared /imsvc${XWIN}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "--target=x86_64-pc-windows-msvc -fms-compatibility-version=19.44 ${XWIN_INCLUDES}")
set(CMAKE_CXX_FLAGS_INIT "--target=x86_64-pc-windows-msvc -fms-compatibility-version=19.44 ${XWIN_INCLUDES} /EHsc")
set(CMAKE_RC_FLAGS_INIT "-I${XWIN}/sdk/include/um -I${XWIN}/sdk/include/shared")
set(XWIN_LIBS "/libpath:${XWIN}/crt/lib/x86_64 /libpath:${XWIN}/sdk/lib/um/x86_64 /libpath:${XWIN}/sdk/lib/ucrt/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${XWIN_LIBS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${XWIN_LIBS}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
