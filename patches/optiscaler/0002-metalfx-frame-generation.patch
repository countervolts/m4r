+#pragma once
+// MetalFX frame interpolation (Apple's FrameGenImpl kernels run by m4r) as an OptiScaler FG output for D3D12 games
+// under vkd3d-proton. At each present the finished frame is captured; once the previous frame is known, the generated
+// in-between frame is presented first, then the real frame.
+// SPDX-License-Identifier: GPL-3.0-only
+#include <framegen/IFGFeature_Dx12.h>
+#include <upscalers/metalfx/M4R_D3D12.h>
+
+class MetalFXFG_Dx12 : public virtual IFGFeature_Dx12
+{
+  private:
+    static constexpr UINT Slots = 8; // command lists in flight (two per presented frame)
+
+    IDXGISwapChain3* _real = nullptr; // the swapchain under OptiScaler's wrapper, not owned: presenting it skips the FG hooks
+    ID3D12DXVKInteropDevice1* _interop = nullptr;
+    m4r_context* _ctx = nullptr;
+    bool _ctxFailed = false;
+    bool _needReset = true;      // the next captured frame has no usable predecessor
+    UINT64 _failedKey = 0;       // sizes of the last failed capture, retried when they change
+    bool _warnedMV = false;
+
+    ID3D12CommandAllocator* _alloc[Slots] {};
+    ID3D12GraphicsCommandList* _list[Slots] {};
+    UINT64 _slotFence[Slots] {};
+    ID3D12Fence* _fence = nullptr;
+    HANDLE _fenceEvent = nullptr;
+    UINT64 _fenceValue = 0;
+    UINT _slot = 0;
+    UINT _cur = 0;
+
+    void CreateRing(ID3D12Device* device);
+    ID3D12GraphicsCommandList* BeginList();
+    bool Submit(ID3D12GraphicsCommandList* list);
+    void WaitIdle();
+    void SetReal(IDXGISwapChain* swapchain);
+    void Pace(double sinceMs);
+
+  protected:
+    void ReleaseObjects() override final;
+    void CreateObjects(ID3D12Device* InDevice) override final;
+
+  public:
+    const char* Name() override final { return "MetalFX FG"; };
+    feature_version Version() override final { return { 1, 0, 0 }; };
+    HWND Hwnd() override final { return _hwnd; };
+
+    bool CreateSwapchainInternal(IDXGIFactory* factory, ID3D12CommandQueue* cmdQueue, DXGI_SWAP_CHAIN_DESC* desc,
+                                 IDXGISwapChain** swapChain) override final;
+    bool CreateSwapchain1Internal(IDXGIFactory* factory, ID3D12CommandQueue* cmdQueue, HWND hwnd,
+                                  DXGI_SWAP_CHAIN_DESC1* desc, DXGI_SWAP_CHAIN_FULLSCREEN_DESC* pFullscreenDesc,
+                                  IDXGISwapChain1** swapChain) override final;
+    bool ReleaseSwapchain(HWND hwnd) override final;
+
+    void CreateContext(ID3D12Device* device, FG_Constants& fgConstants) override final;
+    void Activate() override final;
+    void Deactivate() override final;
+    void DestroyFGContext() override final;
+    bool Shutdown() override final;
+    void EvaluateState(ID3D12Device* device, FG_Constants& fgConstants) override final;
+    bool Present() override final;
+    bool SetResource(Dx12Resource* inputResource) override final;
+    void SetCommandQueue(FG_ResourceType type, ID3D12CommandQueue* queue) override final;
+    void* FrameGenerationContext() override final { return _ctx; }
+    void* SwapchainContext() override final { return nullptr; }
+    bool SetInterpolatedFrameCount(UINT interpolatedFrameCount) override { return interpolatedFrameCount <= 1; };
+
+    MetalFXFG_Dx12() : IFGFeature_Dx12(), IFGFeature() { _framesToInterpolate = 1; }
+    ~MetalFXFG_Dx12() { ReleaseObjects(); }
+};
