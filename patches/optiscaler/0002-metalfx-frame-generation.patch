+// SPDX-License-Identifier: GPL-3.0-only
+#include "pch.h"
+#include "MetalFXFG_Dx12.h"
+#include <framegen/reprojection/swapchain/reprojectionSwapchain.h>
+
+#include <Config.h>
+#include <State.h>
+#include <hudfix/Hudfix_Dx12.h>
+#include <hudfix/Hudfix_Dx11.h>
+#include <menu/menu_overlay_dx.h>
+
+#include <magic_enum.hpp>
+
+// The swapchain wrapper of the reprojection output only forwards to the real swapchain, so it is reused here.
+
+void MetalFXFG_Dx12::SetReal(IDXGISwapChain* swapchain)
+{
+    _real = nullptr;
+    IDXGISwapChain3* sc3 = nullptr;
+    if (swapchain != nullptr && SUCCEEDED(swapchain->QueryInterface(IID_PPV_ARGS(&sc3))) && sc3 != nullptr)
+    {
+        _real = sc3;
+        sc3->Release(); // the wrapper keeps the real swapchain alive; a second owner would block its release
+    }
+}
+
+void MetalFXFG_Dx12::WaitIdle()
+{
+    if (_fence == nullptr || _fenceEvent == nullptr || _gameCommandQueue == nullptr || _fenceValue == 0)
+        return;
+
+    const UINT64 value = ++_fenceValue;
+    if (FAILED(_gameCommandQueue->Signal(_fence, value)))
+        return;
+    if (_fence->GetCompletedValue() < value && SUCCEEDED(_fence->SetEventOnCompletion(value, _fenceEvent)))
+        WaitForSingleObject(_fenceEvent, 2000);
+}
+
+void MetalFXFG_Dx12::ReleaseObjects()
+{
+    WaitIdle();
+
+    for (size_t i = 0; i < BUFFER_COUNT; i++)
+    {
+        SAFE_RELEASE(_uiCommandAllocator[i]);
+        SAFE_RELEASE(_uiCommandList[i]);
+        SAFE_RELEASE(_scCommandAllocator[i]);
+        SAFE_RELEASE(_scCommandList[i]);
+
+        _scCommandListResetted[i] = false;
+        _scAllocatorFenceValues[i] = 0;
+        _uiCommandListResetted[i] = false;
+        _uiAllocatorFenceValues[i] = 0;
+    }
+
+    for (UINT i = 0; i < Slots; i++)
+    {
+        SAFE_RELEASE(_list[i]);
+        SAFE_RELEASE(_alloc[i]);
+        _slotFence[i] = 0;
+    }
+    SAFE_RELEASE(_fence);
+    SAFE_CLOSE_HANDLE(_fenceEvent);
+    _fenceValue = 0;
+
+    if (_ctx != nullptr)
+    {
+        if (auto& m4r = M4RProxy::Get(); m4r.destroy != nullptr)
+            m4r.destroy(_ctx);
+        _ctx = nullptr;
+    }
+    SAFE_RELEASE(_interop);
+    _ctxFailed = false;
+    _needReset = true;
+    _failedKey = 0;
+
+    _renderUI.reset();
+    _hudlessCompare.reset();
+    _mvFlip.reset();
+    _depthFlip.reset();
+
+    ReleaseResourceCopies();
+}
+
+void MetalFXFG_Dx12::CreateObjects(ID3D12Device* InDevice)
+{
+    _device = InDevice;
+
+    if (_uiCommandAllocator[0] != nullptr)
+        return;
+
+    // The base class's UI and swapchain command lists (hudfix and UI composition record into them)
+    for (size_t i = 0; i < BUFFER_COUNT; i++)
+    {
+        _scCommandListResetted[i] = false;
+        _scAllocatorFenceValues[i] = 0;
+        _uiCommandListResetted[i] = false;
+        _uiAllocatorFenceValues[i] = 0;
+
+        InDevice->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&_uiCommandAllocator[i]));
+        _uiCommandAllocator[i]->SetName(std::format(L"_uiCommandAllocator[{}]", i).c_str());
+        InDevice->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, _uiCommandAllocator[i], NULL,
+                                    IID_PPV_ARGS(&_uiCommandList[i]));
+        _uiCommandList[i]->SetName(std::format(L"_uiCommandList[{}]", i).c_str());
+        _uiCommandList[i]->Close();
+
+        if (_uiFence == nullptr)
+        {
+            InDevice->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&_uiFence));
+            _uiFenceEvent = CreateEvent(nullptr, FALSE, FALSE, nullptr);
+        }
+
+        InDevice->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&_scCommandAllocator[i]));
+        _scCommandAllocator[i]->SetName(std::format(L"_scCommandAllocator[{}]", i).c_str());
+        InDevice->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, _scCommandAllocator[i], NULL,
+                                    IID_PPV_ARGS(&_scCommandList[i]));
+        _scCommandList[i]->SetName(std::format(L"_scCommandList[{}]", i).c_str());
+        _scCommandList[i]->Close();
+
+        if (_scFence == nullptr)
+        {
+            InDevice->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&_scFence));
+            _scFenceEvent = CreateEvent(nullptr, FALSE, FALSE, nullptr);
+        }
+    }
+
+    CreateRing(InDevice);
+}
+
+// The command lists m4r records into, and the fence that tells when an allocator can be reused
+void MetalFXFG_Dx12::CreateRing(ID3D12Device* InDevice)
+{
+    if (_list[0] != nullptr || InDevice == nullptr)
+        return;
+
+    for (UINT i = 0; i < Slots; i++)
+    {
+        InDevice->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&_alloc[i]));
+        InDevice->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, _alloc[i], NULL, IID_PPV_ARGS(&_list[i]));
+        _list[i]->SetName(std::format(L"MetalFXFG list[{}]", i).c_str());
+        _list[i]->Close();
+        _slotFence[i] = 0;
+    }
+    InDevice->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&_fence));
+    _fenceEvent = CreateEvent(nullptr, FALSE, FALSE, nullptr);
+    _slot = 0;
+}
+
+bool MetalFXFG_Dx12::CreateSwapchainInternal(IDXGIFactory* factory, ID3D12CommandQueue* cmdQueue,
+                                             DXGI_SWAP_CHAIN_DESC* desc, IDXGISwapChain** swapChain)
+{
+    IDXGISwapChain* realSwapchain {};
+    auto result = factory->CreateSwapChain(cmdQueue, desc, &realSwapchain);
+
+    if (result == S_OK && swapChain)
+    {
+        SetReal(realSwapchain);
+        *swapChain = new ReprojectionDXGISwapChain(realSwapchain, cmdQueue, desc->OutputWindow, 0, false);
+
+        _gameCommandQueue = cmdQueue;
+        _swapChain = *swapChain;
+        _hwnd = desc->OutputWindow;
+        return true;
+    }
+    return false;
+}
+
+bool MetalFXFG_Dx12::CreateSwapchain1Internal(IDXGIFactory* factory, ID3D12CommandQueue* cmdQueue, HWND hwnd,
+                                              DXGI_SWAP_CHAIN_DESC1* desc,
+                                              DXGI_SWAP_CHAIN_FULLSCREEN_DESC* pFullscreenDesc,
+                                              IDXGISwapChain1** swapChain)
+{
+    IDXGIFactory2* factory2 = nullptr;
+    if (factory->QueryInterface(IID_PPV_ARGS(&factory2)) != S_OK)
+        return false;
+
+    IDXGISwapChain1* realSwapchain1 {};
+    auto result = factory2->CreateSwapChainForHwnd(cmdQueue, hwnd, desc, pFullscreenDesc, nullptr, &realSwapchain1);
+    factory2->Release();
+
+    if (result == S_OK && swapChain)
+    {
+        SetReal(realSwapchain1);
+        *swapChain = new ReprojectionDXGISwapChain(realSwapchain1, cmdQueue, hwnd, 0, false);
+
+        _gameCommandQueue = cmdQueue;
+        _swapChain = *swapChain;
+        _hwnd = hwnd;
+        return true;
+    }
+    return false;
+}
+
+bool MetalFXFG_Dx12::ReleaseSwapchain(HWND hwnd)
+{
+    if (hwnd != _hwnd || _hwnd == NULL)
+        return false;
+
+    MenuOverlayDx::CleanupRenderTarget(true, NULL);
+    ReleaseObjects();
+    _real = nullptr;
+    return true;
+}
+
+void MetalFXFG_Dx12::CreateContext(ID3D12Device* device, FG_Constants& fgConstants)
+{
+    if (_device != nullptr)
+        return;
+
+    _device = device;
+    CreateObjects(device);
+}
+
+void MetalFXFG_Dx12::Activate()
+{
+    LOG_DEBUG("MetalFX FG: Activate, active {}, paused {}, frame {}", _isActive, IsPaused(), _frameCount);
+    if (!_isActive)
+    {
+        UpdateTarget();
+        _needReset = true;
+        _isActive = true;
+    }
+}
+
+void MetalFXFG_Dx12::Deactivate()
+{
+    LOG_DEBUG("MetalFX FG: Deactivate, active {}, paused {}, frame {}", _isActive, IsPaused(), _frameCount);
+    if (_isActive)
+    {
+        _isActive = false;
+        _needReset = true;
+    }
+}
+
+void MetalFXFG_Dx12::DestroyFGContext()
+{
+    LOG_DEBUG("MetalFX FG: DestroyFGContext, active {}, paused {}, frame {}", _isActive, IsPaused(), _frameCount);
+    Deactivate();
+    ReleaseObjects();
+}
+
+bool MetalFXFG_Dx12::Shutdown()
+{
+    LOG_DEBUG("MetalFX FG: Shutdown, active {}, paused {}, frame {}", _isActive, IsPaused(), _frameCount);
+    MenuOverlayDx::CleanupRenderTarget(true, NULL);
+    DestroyFGContext();
+    return true;
+}
+
+void MetalFXFG_Dx12::EvaluateState(ID3D12Device* device, FG_Constants& fgConstants)
+{
+    OwnedLockGuard lock(Mutex, 555);
+
+    if (State::Instance().isShuttingDown)
+        return;
+
+    _constants = fgConstants;
+
+    if (Config::Instance()->IsFGEnabled())
+    {
+        LOG_TRACE("MetalFX FG: EvaluateState, active {}, paused {}, frame {}, target {}", _isActive, IsPaused(), _frameCount, _targetFrame);
+        if (_device == nullptr)
+            CreateContext(device, fgConstants);
+
+        if (!IsPaused() && !IsActive())
+            Activate();
+    }
+    else
+    {
+        Deactivate();
+        ReleaseResourceCopies();
+    }
+
+    if (State::Instance().fgChanged)
+    {
+        LOG_DEBUG("FGchanged");
+
+        State::Instance().fgChanged = false;
+
+        Hudfix_Dx12::ResetCounters();
+        Hudfix_Dx11::ResetCounters();
+
+        // Pause for 10 frames
+        UpdateTarget();
+        _needReset = true;
+
+        if (Mutex.getOwner() == 2)
+            Mutex.unlockThis(2);
+    }
+}
+
+// A command list from the ring; waits for the GPU to be done with the allocator's previous use
+ID3D12GraphicsCommandList* MetalFXFG_Dx12::BeginList()
+{
+    if (_list[0] == nullptr || _fence == nullptr)
+        CreateRing(_device);   // released with the other objects when the feature went away; the device is still known
+    if (_list[0] == nullptr || _fence == nullptr)
+    {
+        LOG_ERROR("MetalFX FG: no command lists");
+        return nullptr;
+    }
+
+    _cur = _slot++ % Slots;
+    if (_slotFence[_cur] != 0 && _fence->GetCompletedValue() < _slotFence[_cur])
+    {
+        if (FAILED(_fence->SetEventOnCompletion(_slotFence[_cur], _fenceEvent)) ||
+            WaitForSingleObject(_fenceEvent, 5000) != WAIT_OBJECT_0)
+        {
+            LOG_ERROR("MetalFX FG: allocator wait failed (slot {}, fence {})", _cur, _slotFence[_cur]);
+            return nullptr;
+        }
+    }
+
+    if (FAILED(_alloc[_cur]->Reset()) || FAILED(_list[_cur]->Reset(_alloc[_cur], nullptr)))
+    {
+        LOG_ERROR("MetalFX FG: command list reset failed");
+        return nullptr;
+    }
+    return _list[_cur];
+}
+
+bool MetalFXFG_Dx12::Submit(ID3D12GraphicsCommandList* list)
+{
+    if (FAILED(list->Close()))
+        return false;
+
+    _gameCommandQueue->ExecuteCommandLists(1, (ID3D12CommandList**) &list);
+    _slotFence[_cur] = ++_fenceValue;
+    _gameCommandQueue->Signal(_fence, _slotFence[_cur]);
+    return true;
+}
+
+// Holds the real frame back after the generated one when the game presents without V-Sync, which would show both
+// frames at once. Half of the game's frame time, taken from the present-to-present time. A guess at good pacing.
+void MetalFXFG_Dx12::Pace(double sinceMs)
+{
+    if (!Config::Instance()->MetalFXFGPacing.value_or_default())
+        return;
+
+    const double frame = State::Instance().lastFGFrameTime;
+    if (frame <= 0.0)
+        return;
+
+    double wait = std::min(frame * 0.5, 50.0) - sinceMs;
+    if (wait < 0.5)
+        return;
+
+    const double end = Util::MillisecondsNow() + wait;
+    if (wait > 2.0)
+        Sleep((DWORD) (wait - 1.5));
+    while (Util::MillisecondsNow() < end)
+        YieldProcessor();
+}
+
+bool MetalFXFG_Dx12::Present()
+{
+    auto& state = State::Instance();
+    auto fIndex = GetIndex();
+    LOG_TRACE("MetalFX FG: Present, frame {}, active {}, paused {}, this {:X}", _frameCount, _isActive, IsPaused(), (size_t) this);
+
+    // Execute what hudfix or UI composition recorded for this frame
+    if (_gameCommandQueue != nullptr)
+    {
+        if (_uiCommandListResetted[fIndex])
+        {
+            if (_uiCommandList[fIndex]->Close() == S_OK)
+                _gameCommandQueue->ExecuteCommandLists(1, (ID3D12CommandList**) &_uiCommandList[fIndex]);
+
+            _gameCommandQueue->Signal(_uiFence, _uiAllocatorFenceValues[fIndex]);
+            _uiCommandListResetted[fIndex] = false;
+        }
+
+        if (_scCommandListResetted[fIndex])
+        {
+            if (_scCommandList[fIndex]->Close() == S_OK)
+                _gameCommandQueue->ExecuteCommandLists(1, (ID3D12CommandList**) &_scCommandList[fIndex]);
+
+            _scCommandListResetted[fIndex] = false;
+        }
+    }
+
+    // Returning false: the caller still presents the real frame
+    if (_real == nullptr || _gameCommandQueue == nullptr || _device == nullptr)
+    {
+        LOG_TRACE("MetalFX FG: not ready, swapchain {:X}, queue {:X}, device {:X}", (size_t) _real, (size_t) _gameCommandQueue, (size_t) _device);
+        return false;
+    }
+
+    if (!IsActive() || IsPaused())
+    {
+        LOG_TRACE("MetalFX FG: not presenting, active {}, paused {} (frame {}, target {})", IsActive(), IsPaused(), _frameCount,
+                  _targetFrame);
+        _needReset = true;
+        return false;
+    }
+
+    auto& m4r = M4RProxy::Get();
+    if (m4r.module == nullptr || m4r.framegenCapture == nullptr || m4r.framegenRestore == nullptr)
+    {
+        LOG_TRACE("MetalFX FG: m4r.dll is not usable");
+        return false;
+    }
+
+    auto depth = GetResource(FG_ResourceType::Depth, fIndex);
+    auto velocity = GetResource(FG_ResourceType::Velocity, fIndex);
+    if (!depth || depth->validity == FG_ResourceValidity::ValidNow || !velocity ||
+        velocity->validity == FG_ResourceValidity::ValidNow)
+    {
+        // no usable depth or motion vectors this frame (menus, loading): the next one starts over
+        LOG_TRACE("MetalFX FG: no usable depth or motion vectors for frame {}", _frameCount);
+        _needReset = true;
+        return false;
+    }
+
+    if (_ctx == nullptr)
+    {
+        if (_ctxFailed)
+        {
+            LOG_TRACE("MetalFX FG: the m4r context could not be created before");
+            return false;
+        }
+
+        _ctx = M4RD3D12::Create(_device, &_interop);
+        if (_ctx == nullptr)
+        {
+            _ctxFailed = true;
+            return false;
+        }
+    }
+
+    ComPtr<ID3D12Resource> backbuffer;
+    if (FAILED(_real->GetBuffer(_real->GetCurrentBackBufferIndex(), IID_PPV_ARGS(&backbuffer))))
+    {
+        LOG_TRACE("MetalFX FG: no back buffer");
+        return false;
+    }
+
+    m4r_framegen_desc d {};
+    d.backbuffer = M4RD3D12::Image(_interop, backbuffer.Get(), D3D12_RESOURCE_STATE_PRESENT);
+    d.depth = M4RD3D12::Image(_interop, depth->GetResource(), depth->state);
+    d.motion = M4RD3D12::Image(_interop, velocity->GetResource(), velocity->state);
+    if (!d.backbuffer.image || !d.depth.image || !d.motion.image)
+    {
+        LOG_TRACE("MetalFX FG: no Vulkan image for the back buffer ({:X}), depth ({:X}) or motion vectors ({:X})",
+                  (size_t) d.backbuffer.image, (size_t) d.depth.image, (size_t) d.motion.image);
+        return false;
+    }
+
+    if (d.motion.width != d.depth.width || d.motion.height != d.depth.height)
+    {
+        if (!_warnedMV)
+            LOG_WARN("MetalFX FG: motion vectors ({}x{}) are not the depth size ({}x{}), display-resolution motion "
+                     "vectors are not supported yet",
+                     d.motion.width, d.motion.height, d.depth.width, d.depth.height);
+        else
+            LOG_TRACE("MetalFX FG: motion vectors and depth differ in size");
+        _warnedMV = true;
+        _needReset = true;
+        return false;
+    }
+
+    const UINT64 key = ((UINT64) d.backbuffer.width << 48) ^ ((UINT64) d.backbuffer.height << 32) ^
+                       ((UINT64) d.depth.width << 16) ^ d.depth.height;
+    if (key == _failedKey)
+    {
+        LOG_TRACE("MetalFX FG: skipping, this size failed before");
+        return false;
+    }
+
+    d.motion_scale_x = _mvScaleX[fIndex] != 0.0f ? _mvScaleX[fIndex] : 1.0f;
+    d.motion_scale_y = _mvScaleY[fIndex] != 0.0f ? _mvScaleY[fIndex] : 1.0f;
+    d.delta_time = _ftDelta[fIndex] > 0.0 ? (float) (_ftDelta[fIndex] / 1000.0) : 0.0f; // m4r takes seconds
+    d.near_plane = _cameraNear[fIndex];
+    d.far_plane = _cameraFar[fIndex];
+    d.depth_reversed = IsInvertedDepth() ? 1 : 0;
+    d.reset = (_needReset || _reset[fIndex] != 0) ? 1 : 0;
+
+    // 1. the finished frame in; the generated frame replaces the backbuffer contents
+    int generated = -1;
+    {
+        auto list = BeginList();
+        if (list == nullptr)
+            return false;
+
+        VkCommandBuffer cb = VK_NULL_HANDLE;
+        if (SUCCEEDED(_interop->BeginVkCommandBufferInterop(list, &cb)) && cb != VK_NULL_HANDLE)
+        {
+            generated = m4r.framegenCapture(_ctx, cb, &d);
+            _interop->EndVkCommandBufferInterop(list);
+        }
+        else
+        {
+            LOG_ERROR("MetalFX FG: BeginVkCommandBufferInterop failed");
+        }
+        Submit(list);
+    }
+
+    if (generated < 0)
+    {
+        LOG_ERROR("MetalFX FG: {} (prepare the plan with m4r's install script for {}x{} / {}x{})",
+                  m4r.lastError(_ctx), d.backbuffer.width, d.backbuffer.height, d.depth.width, d.depth.height);
+        _failedKey = key;
+        _needReset = true;
+        return false;
+    }
+
+    _needReset = false;
+    LOG_TRACE("MetalFX FG: frame {} captured, generated {}", _frameCount, generated);
+    if (generated == 0)
+        return false;
+
+    // 2. present the generated frame the way the game presents
+    UINT sync = state.fgPresentSyncInterval;
+    UINT flags = state.fgPresentFlags;
+    if (auto config = Config::Instance(); config->ForceVsync.has_value())
+    {
+        if (!config->ForceVsync.value())
+        {
+            sync = 0;
+            if (state.SCAllowTearing && !state.realExclusiveFullscreen)
+                flags |= DXGI_PRESENT_ALLOW_TEARING;
+        }
+        else
+        {
+            sync = std::max<UINT>(config->VsyncInterval.value_or_default(), 1);
+            flags &= ~DXGI_PRESENT_ALLOW_TEARING;
+        }
+    }
+
+    const double presentStart = Util::MillisecondsNow();
+    const HRESULT hr = _real->Present(sync, flags & DXGI_PRESENT_ALLOW_TEARING);
+    if (FAILED(hr))
+        LOG_ERROR("MetalFX FG: present of the generated frame failed: {:X}", (UINT) hr);
+
+    // 3. the real frame into the next backbuffer, which the caller presents
+    ComPtr<ID3D12Resource> next;
+    if (SUCCEEDED(_real->GetBuffer(_real->GetCurrentBackBufferIndex(), IID_PPV_ARGS(&next))))
+    {
+        const m4r_image im = M4RD3D12::Image(_interop, next.Get(), D3D12_RESOURCE_STATE_PRESENT);
+        if (auto list = BeginList())
+        {
+            VkCommandBuffer cb = VK_NULL_HANDLE;
+            if (SUCCEEDED(_interop->BeginVkCommandBufferInterop(list, &cb)) && cb != VK_NULL_HANDLE)
+            {
+                if (m4r.framegenRestore(_ctx, cb, &im) != 0)
+                    LOG_ERROR("MetalFX FG: {}", m4r.lastError(_ctx));
+                _interop->EndVkCommandBufferInterop(list);
+            }
+            Submit(list);
+        }
+    }
+
+    // 4. pacing
+    if (sync == 0)
+        Pace(Util::MillisecondsNow() - presentStart);
+
+    return false;
+}
+
+bool MetalFXFG_Dx12::SetResource(Dx12Resource* inputResource)
+{
+    if (inputResource == nullptr || inputResource->resource == nullptr)
+        return false;
+
+    auto type = inputResource->type;
+
+    // Only the depth and the motion vectors are used; the frame itself comes from the backbuffer
+    if (type != FG_ResourceType::Depth && type != FG_ResourceType::Velocity)
+        return false;
+
+    auto fIndex = inputResource->frameIndex < 0 ? GetIndex() : inputResource->frameIndex;
+
+    std::unique_lock<std::shared_mutex> lock(_resourceMutex[fIndex]);
+
+    // Making a copy if it's just valid now to be able to use it at present
+    if (IsActive() && inputResource->validity == FG_ResourceValidity::ValidNow)
+        inputResource->validity = FG_ResourceValidity::ValidButMakeCopy;
+
+    auto fResource = &_frameResources[fIndex][type];
+    fResource->type = type;
+    fResource->state = inputResource->state;
+    fResource->validity = inputResource->validity;
+    fResource->resource = inputResource->resource;
+    fResource->cmdList = inputResource->cmdList;
+
+    fResource->top = inputResource->top;
+    fResource->left = inputResource->left;
+    fResource->width = inputResource->width;
+    fResource->height = inputResource->height;
+
+    if (inputResource->cmdList != nullptr && fResource->validity == FG_ResourceValidity::ValidButMakeCopy)
+    {
+        LOG_DEBUG("Making a resource copy of: {}", magic_enum::enum_name(type));
+
+        ID3D12Resource* copyOutput = nullptr;
+
+        if (_resourceCopy[fIndex].contains(type))
+            copyOutput = _resourceCopy[fIndex][type];
+
+        if (!CopyResource(inputResource->cmdList, inputResource->resource, &copyOutput, inputResource->state))
+        {
+            LOG_ERROR("{}, CopyResource error!", magic_enum::enum_name(type));
+            return false;
+        }
+
+        _resourceCopy[fIndex][type] = copyOutput;
+        _resourceCopy[fIndex][type]->SetName(std::format(L"_resourceCopy[{}][{}]", fIndex, (UINT) type).c_str());
+        fResource->copy = copyOutput;
+        fResource->state = D3D12_RESOURCE_STATE_COPY_DEST;
+
+        fResource->validity = FG_ResourceValidity::UntilPresent;
+    }
+
+    SetResourceReady(type, fIndex);
+    return true;
+}
+
+void MetalFXFG_Dx12::SetCommandQueue(FG_ResourceType type, ID3D12CommandQueue* queue) { _gameCommandQueue = queue; }
