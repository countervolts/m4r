+static double NowMs()
+{
+    using namespace std::chrono;
+    return duration<double, std::milli>(steady_clock::now().time_since_epoch()).count();
+}
+
+namespace
+{
+// The keys d4r's FSR Ray Regeneration adapter reads for the same request (docs/dlssd-inputs.md in the m4r repository).
+struct RrInput
+{
+    const char* key;
+    const char* label;
+};
+constexpr RrInput kInputs[] = {
+    { "Color", "color" },
+    { "Depth", "depth" },
+    { "MotionVectors", "motion" },
+    { "DLSS.Input.DiffuseAlbedo", "diffuse albedo" },
+    { "GBuffer.DiffuseAlbedo", "diffuse albedo (GBuffer)" },
+    { "DLSS.Input.SpecularAlbedo", "specular albedo" },
+    { "GBuffer.SpecularAlbedo", "specular albedo (GBuffer)" },
+    { "GBuffer.Normals", "normals" },
+    { "GBuffer.Roughness", "roughness" },
+    { "DLSSD.SpecularHitDistance", "specular hit distance" },
+    { "DLSSD.SpecularRayDirectionHitDistance", "specular ray dir + hit distance" },
+    { "DLSSD.DiffuseHitDistance", "diffuse hit distance" },
+    { "DLSSD.DiffuseRayDirectionHitDistance", "diffuse ray dir + hit distance" },
+    { "DLSSD.ColorBeforeParticles", "color before particles" },
+    { "DLSSD.OutputAlpha", "output alpha" },
+    { "ExposureTexture", "exposure" },
+    { "Output", "output" },
+};
+
+ID3D12Resource* Res(NVSDK_NGX_Parameter* p, const char* key)
+{
+    ID3D12Resource* r = nullptr;
+    if (p->Get(key, &r) != NVSDK_NGX_Result_Success)
+        p->Get(key, (void**) &r);
+    return r;
+}
+} // namespace
+
+// The Ray Reconstruction inputs as m4r_denoise_desc (m4r.h); false when the game gives too little
+bool MetalFXDenoiserFeatureDx12::FillDesc(NVSDK_NGX_Parameter* p, m4r_denoise_desc& d_)
+{
+    const auto srv = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    auto img = [&](const char* key) { return Image(Res(p, key), srv); };
+    m4r_denoise_desc& d = d_;
+    d.color = img("Color");
+    d.depth = img("Depth");
+    d.motion = img("MotionVectors");
+    d.diffuse_albedo = img("DLSS.Input.DiffuseAlbedo");
+    if (!d.diffuse_albedo.image) d.diffuse_albedo = img("GBuffer.DiffuseAlbedo");
+    d.specular_albedo = img("DLSS.Input.SpecularAlbedo");
+    if (!d.specular_albedo.image) d.specular_albedo = img("GBuffer.SpecularAlbedo");
+    d.normals = img("GBuffer.Normals");
+    d.roughness = img("GBuffer.Roughness");
+    d.specular_hit = img("DLSSD.SpecularHitDistance");
+    if (!d.specular_hit.image) { d.specular_hit = img("DLSSD.SpecularRayDirectionHitDistance"); d.specular_hit_in_w = d.specular_hit.image != nullptr; }
+    d.diffuse_hit = img("DLSSD.DiffuseHitDistance");
+    d.color_before_particles = img("DLSSD.ColorBeforeParticles");
+    d.exposure = img("ExposureTexture");
+    d.output = Image(Res(p, "Output"), D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    void *world = nullptr, *proj = nullptr;
+    p->Get("WorldToViewMatrix", &world);
+    p->Get("ViewToClipMatrix", &proj);
+    if (world) memcpy(d.world_to_view, world, sizeof d.world_to_view);
+    if (proj) memcpy(d.view_to_clip, proj, sizeof d.view_to_clip);
+    unsigned int rw = 0, rh = 0;
+    GetRenderResolution(p, &rw, &rh);
+    d.content_width = rw; d.content_height = rh;
+    p->Get(NVSDK_NGX_Parameter_Jitter_Offset_X, &d.jitter_x);
+    p->Get(NVSDK_NGX_Parameter_Jitter_Offset_Y, &d.jitter_y);
+    d.motion_scale_x = d.motion_scale_y = 1.0f;
+    p->Get(NVSDK_NGX_Parameter_MV_Scale_X, &d.motion_scale_x);
+    p->Get(NVSDK_NGX_Parameter_MV_Scale_Y, &d.motion_scale_y);
+    d.pre_exposure = 1.0f;
+    p->Get(NVSDK_NGX_Parameter_DLSS_Pre_Exposure, &d.pre_exposure);
+    p->Get(NVSDK_NGX_Parameter_Reset, &d.reset);
+    p->Get("DLSS.Use.HW.Depth", &d.hardware_depth);
+    int roughnessMode = 0;
+    p->Get("DLSS.Roughness.Mode", &roughnessMode);
+    d.roughness_in_normals_w = roughnessMode == 1;
+    d.depth_reversed = DepthInverted() ? 1 : 0;
+    d.motion_low_res = LowResMV() ? 1 : 0;
+    d.flip_upscale_jitter = Config::Instance()->MetalFXFlipJitter.value_or(false) ? 1 : 0;
+    d.fast_math = Config::Instance()->MetalFXFastMath.value_or_default() ? 1 : 0;
+    return true;
+}
+
+// M4R_DUMP_RR=<dir>: dumps the Ray Reconstruction inputs of a few frames (see m4r.h) for offline work on the denoiser
+void MetalFXDenoiserFeatureDx12::Capture(ID3D12GraphicsCommandList* cmd, NVSDK_NGX_Parameter* p)
+{
+    auto& m4r = M4RProxy::Get();
+    if (m4r.denoiseCapture == nullptr || _ctx == nullptr || _interop == nullptr)
+        return;
+    static const bool enabled = GetEnvironmentVariableA("M4R_DUMP_RR", nullptr, 0) != 0;
+    if (!enabled)
+        return;
+    m4r_denoise_desc d {};
+    FillDesc(p, d);
+    VkCommandBuffer cb = VK_NULL_HANDLE;
+    if (FAILED(_interop->BeginVkCommandBufferInterop(cmd, &cb)) || cb == VK_NULL_HANDLE)
+        return;
+    m4r.denoiseCapture(_ctx, cb, &d);
+    _interop->EndVkCommandBufferInterop(cmd);
+}
+
+bool MetalFXDenoiserFeatureDx12::InitInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters)
+{
+    if (!MetalFXFeatureDx12::InitInternal(InCommandList, InParameters))
+        return false;
+    auto& m4r = M4RProxy::Get();
+    if (m4r.denoiseInit == nullptr || m4r.denoise == nullptr || GetEnvironmentVariableA("M4R_NO_DENOISE", nullptr, 0) != 0)
+    {
+        LOG_WARN("MetalFX Ray Reconstruction: the denoiser is off, upscaling only");
+        return true;
+    }
+    if (m4r.denoiseInit(_ctx, DisplayWidth(), DisplayHeight(), RenderWidth(), RenderHeight()) != 0)
+    {
+        LOG_ERROR("MetalFX denoiser: {} (prepare it with m4r's install script for {}x{}); upscaling only",
+                  m4r.lastError(_ctx), RenderWidth(), RenderHeight());
+        return true;
+    }
+    _denoise = true;
+    _tDenoise = std::make_unique<GpuTime_Dx12>(Device);
+    _tDlss = std::make_unique<GpuTime_Dx12>(Device);
+    LOG_INFO("MetalFX denoiser: ready, {}x{}", RenderWidth(), RenderHeight());
+    if (Config::Instance()->MetalFXDenoiserDlss.value_or_default() && !InitDlss(InCommandList, InParameters))
+        LOG_WARN("MetalFX denoiser: DLSS Super Resolution is not available, upscaling with the MetalFX upscaler");
+    return true;
+}
+
+MetalFXDenoiserFeatureDx12::~MetalFXDenoiserFeatureDx12()
+{
+    ReleaseDlss();
+}
+
+// called by OptiScaler once per frame with the queue: reads the stage timers and logs averages (frames 30, 60, 120, then every 300)
+std::optional<double> MetalFXDenoiserFeatureDx12::ReadUpscalerTime(void* commandQueue)
+{
+    const auto total = MetalFXFeatureDx12::ReadUpscalerTime(commandQueue);
+    if (_tDenoise == nullptr || _tDlss == nullptr)
+        return total;
+    const auto a = _tDenoise->ReadGpuTime((ID3D12CommandQueue*) commandQueue);
+    const auto b = _tDlss->ReadGpuTime((ID3D12CommandQueue*) commandQueue);
+    if (a && b && total)
+    {
+        _gpuDenoise += *a;
+        _gpuDlss += *b;
+        _gpuTotal += *total;
+        ++_timeN;
+    }
+    ++_timeCalls;
+    if (_timeN > 0 && (_timeCalls == 30 || _timeCalls == 60 || _timeCalls == 120 || _timeCalls % 300 == 0))
+    {
+        LOG_INFO("MetalFX denoiser timing, {} frames in: GPU denoise {:.2f} ms, DLSS {:.2f} ms, OptiScaler's upscaler time {:.2f} ms "
+                 "(mean of the last {}; CPU recording denoise {:.2f} ms, DLSS {:.2f} ms per frame)",
+                 _timeCalls, _gpuDenoise / _timeN, _gpuDlss / _timeN, _gpuTotal / _timeN, _timeN,
+                 _cpuDenoise / std::max(1, _timeN), _cpuDlss / std::max(1, _timeN));
+        _gpuDenoise = _gpuDlss = _gpuTotal = _cpuDenoise = _cpuDlss = 0;
+        _timeN = 0;
+    }
+    return total;
+}
+
+void MetalFXDenoiserFeatureDx12::ReleaseDlss()
+{
+    _dlss.reset();
+    if (_dnColor) { _dnColor->Release(); _dnColor = nullptr; }
+    if (_dnDepth) { _dnDepth->Release(); _dnDepth = nullptr; }
+}
+
+static ID3D12Resource* CreateTexture(ID3D12Device* device, UINT w, UINT h, DXGI_FORMAT format)
+{
+    D3D12_HEAP_PROPERTIES hp {};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd {};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = w;
+    rd.Height = h;
+    rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1;
+    rd.Format = format;
+    rd.SampleDesc.Count = 1;
+    rd.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    ID3D12Resource* res = nullptr;
+    if (FAILED(device->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&res))))
+        return nullptr;
+    return res;
+}
+
+bool MetalFXDenoiserFeatureDx12::InitDlss(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters)
+{
+    if (NVNGXProxy::NVNGXModule() == nullptr)
+        NVNGXProxy::InitNVNGX();
+    if (NVNGXProxy::NVNGXModule() == nullptr)
+    {
+        LOG_ERROR("MetalFX denoiser + DLSS: no NGX proxy loaded (Libraries.NvngxPath, e.g. d4r\\nvngx.dll)");
+        return false;
+    }
+    int hwDepth = 0;
+    InParameters->Get("DLSS.Use.HW.Depth", &hwDepth);
+    _dnColor = CreateTexture(Device, RenderWidth(), RenderHeight(), DXGI_FORMAT_R16G16B16A16_FLOAT);
+    if (hwDepth == 0)
+        _dnDepth = CreateTexture(Device, RenderWidth(), RenderHeight(), DXGI_FORMAT_R32_FLOAT);
+    if (_dnColor == nullptr || (hwDepth == 0 && _dnDepth == nullptr))
+    {
+        LOG_ERROR("MetalFX denoiser + DLSS: could not create the intermediate textures");
+        ReleaseDlss();
+        return false;
+    }
+    _dlss = std::make_unique<DLSSFeatureDx12>(IFeature::GetNextHandleId(), InParameters);
+    if (!_dlss->Init(Device, InCommandList, InParameters) || !_dlss->IsInited())
+    {
+        LOG_ERROR("MetalFX denoiser + DLSS: creating the DLSS Super Resolution feature failed");
+        ReleaseDlss();
+        return false;
+    }
+    _dnShaderState = false;
+    LOG_INFO("MetalFX denoiser: the denoised image is upscaled by DLSS Super Resolution ({}x{} -> {}x{}, {} depth)", RenderWidth(),
+             RenderHeight(), DisplayWidth(), DisplayHeight(), hwDepth ? "the game's" : "converted");
+    return true;
+}
+
+void MetalFXDenoiserFeatureDx12::Transition(ID3D12GraphicsCommandList* cmd, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+{
+    D3D12_RESOURCE_BARRIER b[2] {};
+    UINT n = 0;
+    for (ID3D12Resource* r : { _dnColor, _dnDepth })
+    {
+        if (r == nullptr)
+            continue;
+        b[n].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[n].Transition.pResource = r;
+        b[n].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[n].Transition.StateBefore = from;
+        b[n].Transition.StateAfter = to;
+        ++n;
+    }
+    if (n)
+        cmd->ResourceBarrier(n, b);
+}
+
+bool MetalFXDenoiserFeatureDx12::EvaluateInternal(ID3D12GraphicsCommandList* InCommandList,
+                                                  NVSDK_NGX_Parameter* InParameters)
+{
+    // first frames, then once in a while: what the game gave us
+    if (_frameCount < 3 || _frameCount % 600 == 0)
+    {
+        LOG_INFO("MetalFX Ray Reconstruction, frame {}: render {}x{} -> {}x{}", _frameCount, RenderWidth(),
+                 RenderHeight(), DisplayWidth(), DisplayHeight());
+        for (const auto& in : kInputs)
+        {
+            ID3D12Resource* r = Res(InParameters, in.key);
+            if (r == nullptr)
+                continue;
+            const auto d = r->GetDesc();
+            LOG_INFO("  {} ({}): {}x{} format {}", in.label, in.key, (unsigned) d.Width, d.Height, (int) d.Format);
+        }
+        int hwDepth = -1, roughnessMode = -1, denoiseMode = -1, reset = 0;
+        InParameters->Get("DLSS.Use.HW.Depth", &hwDepth);
+        InParameters->Get("DLSS.Roughness.Mode", &roughnessMode);
+        InParameters->Get("DLSS.Denoise.Mode", &denoiseMode);
+        InParameters->Get(NVSDK_NGX_Parameter_Reset, &reset);
+        float jx = 0, jy = 0, mvx = 1, mvy = 1, pre = 1;
+        InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_X, &jx);
+        InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_Y, &jy);
+        InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_X, &mvx);
+        InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_Y, &mvy);
+        InParameters->Get(NVSDK_NGX_Parameter_DLSS_Pre_Exposure, &pre);
+        void *world = nullptr, *proj = nullptr;
+        InParameters->Get("WorldToViewMatrix", &world);
+        InParameters->Get("ViewToClipMatrix", &proj);
+        LOG_INFO("  hwDepth {} roughnessMode {} denoiseMode {} reset {} jitter {:.3f},{:.3f} mvScale {:.3f},{:.3f} "
+                 "preExposure {:.3f} depthInverted {} lowResMV {} matrices {}/{}",
+                 hwDepth, roughnessMode, denoiseMode, reset, jx, jy, mvx, mvy, pre, DepthInverted(), LowResMV(),
+                 world != nullptr, proj != nullptr);
+    }
+    Capture(InCommandList, InParameters);
+    if (_denoise)
+    {
+        m4r_denoise_desc d {};
+        if (FillDesc(InParameters, d))
+        {
+            const bool useDlss = _dlss != nullptr;
+            if (useDlss)
+            {
+                if (_dnShaderState)   // DLSS read the textures last frame: back to writable
+                    Transition(InCommandList, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+                _dnShaderState = false;
+                d.denoised_out = Image(_dnColor, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+                if (_dnDepth)
+                    d.depth_out = Image(_dnDepth, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+            }
+            VkCommandBuffer cb = VK_NULL_HANDLE;
+            const double t0 = NowMs();
+            if (_tDenoise)
+                _tDenoise->Start(InCommandList);
+            if (SUCCEEDED(_interop->BeginVkCommandBufferInterop(InCommandList, &cb)) && cb != VK_NULL_HANDLE)
+            {
+                auto& m4r = M4RProxy::Get();
+                const int r = m4r.denoise(_ctx, cb, &d);
+                _interop->EndVkCommandBufferInterop(InCommandList);
+                if (_tDenoise)
+                    _tDenoise->End(InCommandList);
+                _cpuDenoise += NowMs() - t0;
+                if (r == 0 && useDlss)
+                {
+                    // m4r wrote the denoised colour (and depth); DLSS Super Resolution upscales it with the game's own other inputs
+                    Transition(InCommandList, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+                    _dnShaderState = true;
+                    void* origColor = nullptr;
+                    void* origDepth = nullptr;
+                    InParameters->Get(NVSDK_NGX_Parameter_Color, &origColor);
+                    InParameters->Get(NVSDK_NGX_Parameter_Depth, &origDepth);
+                    InParameters->Set(NVSDK_NGX_Parameter_Color, (void*) _dnColor);
+                    if (_dnDepth)
+                        InParameters->Set(NVSDK_NGX_Parameter_Depth, (void*) _dnDepth);
+                    const double t1 = NowMs();
+                    if (_tDlss)
+                        _tDlss->Start(InCommandList);
+                    const bool ok = _dlss->EvaluateInternal(InCommandList, InParameters);
+                    if (_tDlss)
+                        _tDlss->End(InCommandList);
+                    _cpuDlss += NowMs() - t1;
+                    InParameters->Set(NVSDK_NGX_Parameter_Color, origColor);
+                    InParameters->Set(NVSDK_NGX_Parameter_Depth, origDepth);
+                    if (ok)
+                    {
+                        _frameCount++;
+                        return true;
+                    }
+                    LOG_ERROR("MetalFX denoiser: DLSS Super Resolution failed, upscaling with the MetalFX upscaler from now on");
+                    ReleaseDlss();
+                    return MetalFXFeatureDx12::EvaluateInternal(InCommandList, InParameters);
+                }
+                if (r == 0)
+                {
+                    _frameCount++;
+                    return true;
+                }
+                LOG_ERROR("MetalFX denoiser: {}", m4r.lastError(_ctx));
+            }
+        }
+        _denoise = false; // do not retry every frame: upscale the noisy colour
+    }
+    return MetalFXFeatureDx12::EvaluateInternal(InCommandList, InParameters);
+}
