+#pragma once
+// NGX feature 13 (DLSS Ray Reconstruction) answered by m4r on GPUs without DLSS: MetalFX's temporal denoiser (render size), then
+// the MetalFX upscaler. Without a denoiser plan (m4r\\plans\\dn-WxH) or with M4R_NO_DENOISE set it only upscales the noisy colour.
+// SPDX-License-Identifier: GPL-3.0-only
+#include "MetalFXFeature_Dx12.h"
+#include <upscalers/dlss/DLSSFeature_Dx12.h>
+#include <memory>
+#include <gpu_time/GpuTime_Dx12.h>
+
+class MetalFXDenoiserFeatureDx12 : public MetalFXFeatureDx12
+{
+  public:
+    MetalFXDenoiserFeatureDx12(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters)
+        : IFeature(InHandleId, InParameters), MetalFXFeatureDx12(InHandleId, InParameters)
+    {
+    }
+
+    bool InitInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters) override;
+    bool EvaluateInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters) override;
+    ~MetalFXDenoiserFeatureDx12();
+    std::optional<double> ReadUpscalerTime(void* commandQueue) override;
+
+  private:
+    bool FillDesc(NVSDK_NGX_Parameter* p, m4r_denoise_desc& d);
+    void Capture(ID3D12GraphicsCommandList* cmd, NVSDK_NGX_Parameter* p);
+    bool _denoise = false;   // the denoiser plan is loaded
+
+    // [MetalFX] DenoiserDlss: the denoised image is upscaled by DLSS Super Resolution (the NGX proxy, e.g. d4r) instead of BBR.
+    // m4r writes the denoised colour (and, for games without hardware depth, the depth in the game's convention) into these
+    // textures; the DLSS feature then runs on them with the game's motion vectors, exposure and jitter.
+    bool InitDlss(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters);
+    void ReleaseDlss();
+    void Transition(ID3D12GraphicsCommandList* cmd, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to);
+    // per-stage timing (logged now and then): GPU time between the D3D12 timestamps around the m4r denoiser and around DLSS, and the
+    // CPU time spent recording each; the sum of the GPU parts is not OptiScaler's number when the command list is split in between
+    std::unique_ptr<GpuTime_Dx12> _tDenoise, _tDlss;
+    double _gpuDenoise = 0, _gpuDlss = 0, _cpuDenoise = 0, _cpuDlss = 0, _gpuTotal = 0;
+    int _timeN = 0, _timeCalls = 0;
+    std::unique_ptr<DLSSFeatureDx12> _dlss;
+    ID3D12Resource* _dnColor = nullptr;   // RGBA16F, render size
+    ID3D12Resource* _dnDepth = nullptr;   // R32F, render size (only when the game has no hardware depth)
+    bool _dnShaderState = false;          // the textures are in the shader-resource state (DLSS read them last)
+};
