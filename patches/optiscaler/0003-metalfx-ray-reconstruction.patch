--- a/OptiScaler.ini
+++ b/OptiScaler.ini
@@ -1344,6 +1344,26 @@ FlipJitter=auto
 ; true or false - Default (auto) is true
 FGPacing=auto
 
+; Answers a game's DLSS Ray Reconstruction request (NGX feature 13) with m4r on GPUs that are not DLSS capable. Needs
+; m4r\m4r.dll, an upscaler plan and a denoiser plan (m4r\plans\dn-WxH) for the sizes in use. Runs MetalFX's temporal
+; denoiser at render size, then the MetalFX upscaler; without a denoiser plan it only upscales the noisy colour.
+; true or false - Default (auto) is false
+Denoiser=auto
+
+; With Denoiser=true: upscale the denoised image with DLSS Super Resolution (the NGX proxy given by Libraries.NvngxPath, e.g. d4r)
+; instead of the MetalFX upscaler. m4r writes the denoised colour (and the depth, for games without hardware depth) into two
+; textures and the DLSS feature upscales those with the game's motion vectors, exposure and jitter. Falls back to the MetalFX
+; upscaler when DLSS cannot be created.
+; true or false - Default (auto) is false
+DenoiserDlss=auto
+
+; The denoiser's bilateral filter (Apple's kernel) on the raw hardware exp/log/sqrt/pow instructions, which is what Metal's fast::
+; functions mean, instead of LLVM's strict (and more accurate) versions: the filter runs about twice as fast (Alan Wake 2, 1280x720:
+; denoiser 3.5 -> 2.8 ms). Not bit-identical: one filter pass is 99.99% identical with a 1 ulp maximum, and after several frames of
+; temporal accumulation 92% of the fp16 values are identical, 98% within 1 ulp, mean difference 7e-5.
+; true or false - Default (auto) is false
+FastMath=auto
+
 ; -------------------------------------------------------
 [Log]
 ; -------------------------------------------------------
