// m4r: hybrid output (NOT MetalFX behaviour; opt-in: M4R_HYBRID=1; on a fast pan over reflections it kept BBR's shimmer, so it is not the default).
// The game's frame is upscaled twice: by MetalFX's V3 stage (UBFNet + V3 filter: clean, no fireflies, softer in motion) and by
// MetalFX's BBR upscaler on the same denoised colour (sharper, keeps the outliers the denoiser leaves). The result is BBR's pixel
// clamped per channel to the range of V3's 5x5 neighbourhood, widened by GROW of that range: detail BBR and V3 agree on stays,
// spikes V3 does not have (fireflies, puddle glitter) are pulled back. RGBA16F buffers at output size; alpha is BBR's.
// args: 0 V3 output [H][W] f16vec4, 1 BBR output (read and written in place); consts 8 W, 9 H
// SPDX-License-Identifier: GPL-3.0-only
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Px { f16vec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Args { uint64_t slot[8]; uint c[8]; uint grid[4]; };
layout(push_constant) uniform Push { Args a; } pc;
const int R = 2;            // 5x5
const float GROW = 0.25;
void main() {
    Args a = pc.a;
    const int W = int(a.c[0]), H = int(a.c[1]);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= W || p.y >= H) return;
    Px v3 = Px(a.slot[0]), bb = Px(a.slot[1]);
    vec3 lo = vec3(65504.0), hi = vec3(-65504.0);
    for (int dy = -R; dy <= R; ++dy)
        for (int dx = -R; dx <= R; ++dx) {
            const ivec2 q = clamp(p + ivec2(dx, dy), ivec2(0), ivec2(W - 1, H - 1));
            const vec3 c = vec3(v3.v[q.y * W + q.x].rgb);
            lo = min(lo, c); hi = max(hi, c);
        }
    const vec3 m = (hi - lo) * GROW;
    const int i = p.y * W + p.x;
    const vec4 b = vec4(bb.v[i]);
    bb.v[i] = f16vec4(vec4(clamp(b.rgb, lo - m, hi + m), b.a));
}
