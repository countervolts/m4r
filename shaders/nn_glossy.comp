// m4r: glossy-in-motion smoothing (NOT MetalFX behaviour; stop-gap for the BBR path, opt-in: M4R_GLOSSY_SMOOTH=1; off by default since in game it flattened moving reflections into plastic-looking patches).
// MetalFX's reproject_warp drops the history of low-roughness pixels that move more than a pixel or so (by design: their reflection
// moves differently from the surface), and the stage Apple relies on for them (UBFNet + V3 filter) is not usable yet. So moving glossy
// pixels leave the denoiser with one frame's worth of samples. This pass blurs them in place, one a-trous iteration (5x5 B-spline taps
// at distance STEP) per dispatch; the plan runs it with steps 1, 2, 4. Taps are weighted by normal, depth and roughness similarity
// (same surface) and by log-luminance distance to the 3x3 geometric mean (keeps reflection edges, stops highlights and specks from
// spreading). The blend toward the blurred value is gated by roughness (full below R0, none above R1) and screen motion (none below
// M0 px, full above M1 px), so static scenes and rough surfaces pass through bit-exactly.
// args: 0 colour in [H][W] f16vec4, 1 colour out, 2 normals f16vec4 (roughness in w), 3 depth float (hardware depth),
//       4 motion f16vec2 (game units), 5 motion scale vec2 (game units -> pixels); consts 8 W, 9 H, 10 STEP
// SPDX-License-Identifier: GPL-3.0-only
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Px { f16vec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer F32 { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Mv { f16vec2 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Ms { vec2 v; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Args { uint64_t slot[8]; uint c[8]; uint grid[4]; };
layout(push_constant) uniform Push { Args a; } pc;
const float R0 = 0.15, R1 = 0.30;     // roughness gate
const float M0 = 1.0, M1 = 3.0;       // motion gate, pixels per frame
const float NEXP = 32.0;              // normal similarity exponent
const float ZREL = 0.01;              // relative depth difference scale (per unit of STEP)
const float RS = 0.03;                // roughness difference scale
const float LSIG = 1.0;               // log-luminance sigma
vec3 nz(vec3 v) { return v * inversesqrt(max(dot(v, v), 1e-12)); }   // zero normals (sky) stay zero
float lum(vec3 c) { return (c.r + c.g + c.b) * (1.0 / 3.0); }
void main() {
    Args a = pc.a;
    const int W = int(a.c[0]), H = int(a.c[1]), STEP = int(a.c[2]);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= W || p.y >= H) return;
    Px src = Px(a.slot[0]), dst = Px(a.slot[1]), nrm = Px(a.slot[2]);
    F32 dep = F32(a.slot[3]); Mv mv = Mv(a.slot[4]); Ms ms = Ms(a.slot[5]);
    const int i = p.y * W + p.x;
    const vec4 c = vec4(src.v[i]);
    const vec4 np = vec4(nrm.v[i]);
    const float r = np.w;
    const vec2 m = vec2(mv.v[i]) * ms.v;
    const float s = (1.0 - smoothstep(R0, R1, r)) * smoothstep(M0, M1, length(m));
    if (!(s > 0.0) || !(dep.v[i] > 0.0)) { dst.v[i] = f16vec4(c); return; }   // depth 0: sky / far plane (reversed depth)
    const vec3 n = nz(np.xyz);
    const float z = dep.v[i];
    float ref = 0.0;
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            const ivec2 q = clamp(p + ivec2(dx, dy), ivec2(0), ivec2(W - 1, H - 1));
            ref += log(lum(vec3(src.v[q.y * W + q.x].rgb)) + 1e-3);
        }
    ref *= 1.0 / 9.0;
    const float B[5] = float[5](1.0 / 16.0, 4.0 / 16.0, 6.0 / 16.0, 4.0 / 16.0, 1.0 / 16.0);
    vec3 acc = vec3(0.0); float wsum = 0.0;
    for (int ky = 0; ky < 5; ++ky)
        for (int kx = 0; kx < 5; ++kx) {
            const ivec2 q = clamp(p + ivec2(kx - 2, ky - 2) * STEP, ivec2(0), ivec2(W - 1, H - 1));
            const int j = q.y * W + q.x;
            const vec3 cq = vec3(src.v[j].rgb);
            const vec4 nq = vec4(nrm.v[j]);
            const float lq = log(lum(cq) + 1e-3) - ref;
            float w = B[ky] * B[kx] * pow(max(dot(n, nz(nq.xyz)), 0.0), NEXP);
            w *= exp(-abs(1.0 - dep.v[j] / z) / (ZREL * float(STEP)) - abs(nq.w - r) / RS - 0.5 * (lq * lq) / (LSIG * LSIG));
            acc += w * cq; wsum += w;
        }
    const vec3 f = wsum > 1e-8 ? acc / wsum : c.rgb;
    dst.v[i] = f16vec4(vec4(mix(c.rgb, f, s), c.a));
}
