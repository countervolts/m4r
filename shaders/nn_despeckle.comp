// m4r: interim firefly clamp between MetalFX's denoiser and the upscaler (the denoiser's own upscaling network, which removes
// the outliers the filter leaves, is not ported yet). A pixel brighter than FACTOR times the third-brightest of its eight neighbours
// is scaled down to that level; three, so that up to two adjacent outliers are still caught. RGBA16F raw image buffers.
// args: 0 input [H][W][4] half, 1 output [H][W][4] half; consts 8 W, 9 H
// SPDX-License-Identifier: GPL-3.0-only
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Px { f16vec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Args { uint64_t slot[8]; uint c[8]; uint grid[4]; };
layout(push_constant) uniform Push { Args a; } pc;
const float FACTOR = 1.5;
float lum(vec3 c) { return (c.r + c.g + c.b) * (1.0 / 3.0); }
void main() {
    Args a = pc.a;
    const int W = int(a.c[0]), H = int(a.c[1]);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= W || p.y >= H) return;
    Px src = Px(a.slot[0]), dst = Px(a.slot[1]);
    const vec4 c = vec4(src.v[p.y * W + p.x]);
    float top[3] = float[3](0.0, 0.0, 0.0);   // three largest neighbour luminances, descending
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            if (dx == 0 && dy == 0) continue;
            const ivec2 q = clamp(p + ivec2(dx, dy), ivec2(0), ivec2(W - 1, H - 1));
            float l = lum(vec3(src.v[q.y * W + q.x].rgb));
            if (l > top[0]) { top[2] = top[1]; top[1] = top[0]; top[0] = l; }
            else if (l > top[1]) { top[2] = top[1]; top[1] = l; }
            else if (l > top[2]) top[2] = l;
        }
    const float l = lum(c.rgb), cap = top[2] * FACTOR + 1e-4;
    const vec3 rgb = l > cap ? c.rgb * (cap / l) : c.rgb;
    dst.v[p.y * W + p.x] = f16vec4(vec4(rgb, c.a));
}
