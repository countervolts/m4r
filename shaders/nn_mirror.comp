// m4r: mirror gating (NOT MetalFX behaviour; M4R_NO_MIRROR_GATE=1 turns it off).
// MetalFX's first stage ends with four a-trous bilateral passes whose edge stopping comes from depth, normals and albedo. On a flat
// mirror (water, wet floor) none of those change inside the reflected image, so the filter smears the reflection to a flat tone
// (Alan Wake 2, static camera, water: gradient strength of the reflected image 0.40 noisy input, 0.35 after MetalFX's temporal blend,
// 0.02 after the filter; MetalFX's own V3 upscaling stage does not bring it back). So on mirror-like pixels the filter's result is
// replaced by the temporal-blend-only result (the same remodulation, run before the bilateral passes), blended by roughness:
// all temporal below R0 = 0.10, all MetalFX filter above R1 = 0.15 (M4R_MIRROR_R0 / M4R_MIRROR_R1), smoothstep between, on the 3x3-averaged
// roughness. No sharpening is involved.
// args: 0 filtered colour (in place) [H][W] f16vec4, 1 temporal-only colour [H][W] f16vec4, 2 roughness [H][W] half,
//       3 params {float r0, float r1, float strength}; consts 8 W, 9 H
// SPDX-License-Identifier: GPL-3.0-only
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Px { f16vec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 2) readonly buffer Half { float16_t v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Par { float r0, r1, strength; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Args { uint64_t slot[8]; uint c[8]; uint grid[4]; };
layout(push_constant) uniform Push { Args a; } pc;
void main() {
    Args a = pc.a;
    const int W = int(a.c[0]), H = int(a.c[1]);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= W || p.y >= H) return;
    Par par = Par(a.slot[3]);
    Half rough = Half(a.slot[2]);
    float r = 0.0;
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            const ivec2 q = clamp(p + ivec2(dx, dy), ivec2(0), ivec2(W - 1, H - 1));
            r += float(rough.v[q.y * W + q.x]);
        }
    r /= 9.0;
    const float t = clamp((r - par.r0) / max(par.r1 - par.r0, 1e-4), 0.0, 1.0);
    const float mirror = (1.0 - t * t * (3.0 - 2.0 * t)) * par.strength;
    if (mirror <= 0.0) return;
    const int i = p.y * W + p.x;
    const vec4 f = vec4(Px(a.slot[0]).v[i]);
    const vec4 g = vec4(Px(a.slot[1]).v[i]);
    Px(a.slot[0]).v[i] = f16vec4(vec4(mix(f.rgb, g.rgb, mirror), f.a));
}
