// m4r: generic NHWC fp16 convolution for MetalFX's DBFNet/UBFNet (same weights and graph as Apple's fused kernels, plain
// fp32 accumulation, fp16 activations). Weights HWIO, bias per output channel, square kernel, zero padding.
// args: 0 input [Hin][Win][Cin], 1 output [Hout][Wout][Cout], 2 weights, 3 bias (f16);
// consts 8 Wout, 9 Hout, 10 Cin, 11 Cout, 12 Win, 13 Hin, 14 kernel | stride << 8 | pad << 16, 15 activation (0 none, 1 relu, 2 sigmoid)
// SPDX-License-Identifier: GPL-3.0-only
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 2) buffer Half { float16_t v[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Args { uint64_t slot[8]; uint c[8]; uint grid[4]; };
layout(push_constant) uniform Push { Args a; } pc;

void main() {
    Args a = pc.a;
    const uint Wo = a.c[0], Ho = a.c[1], Cin = a.c[2], Cout = a.c[3], Wi = a.c[4], Hi = a.c[5];
    const uint k = a.c[6] & 255u, st = (a.c[6] >> 8) & 255u, pad = a.c[6] >> 16, act = a.c[7];
    const uvec2 p = gl_GlobalInvocationID.xy;
    const uint co0 = gl_GlobalInvocationID.z * 8u;   // one thread = 8 output channels of one pixel
    if (p.x >= Wo || p.y >= Ho || co0 >= Cout) return;
    Half src = Half(a.slot[0]), dst = Half(a.slot[1]), wt = Half(a.slot[2]), bias = Half(a.slot[3]);
    {
        const uint n = min(8u, Cout - co0);
        float acc[8];
        for (uint i = 0u; i < 8u; ++i) acc[i] = i < n ? float(bias.v[co0 + i]) : 0.0;
        for (uint ky = 0u; ky < k; ++ky) {
            const int iy = int(p.y * st + ky) - int(pad);
            if (iy < 0 || iy >= int(Hi)) continue;
            for (uint kx = 0u; kx < k; ++kx) {
                const int ix = int(p.x * st + kx) - int(pad);
                if (ix < 0 || ix >= int(Wi)) continue;
                const uint ib = (uint(iy) * Wi + uint(ix)) * Cin;
                const uint wb = (ky * k + kx) * Cin * Cout + co0;
                for (uint ci = 0u; ci < Cin; ++ci) {
                    const float x = float(src.v[ib + ci]);
                    const uint wo = wb + ci * Cout;
                    for (uint i = 0u; i < 8u; ++i)
                        if (i < n) acc[i] += x * float(wt.v[wo + i]);
                }
            }
        }
        const uint ob = (p.y * Wo + p.x) * Cout + co0;
        for (uint i = 0u; i < 8u; ++i) {
            if (i >= n) break;
            float v = acc[i];
            if (act == 1u) v = max(v, 0.0);
            else if (act == 2u) v = 1.0 / (1.0 + exp(-v));
            dst.v[ob + i] = float16_t(v);
        }
    }
}
