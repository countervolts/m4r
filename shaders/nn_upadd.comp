// m4r: bilinear x2 upsample (half-pixel centres, edge clamp) plus skip, NHWC fp16.
// args: 0 input [H/2][W/2][C], 1 skip [H][W][C], 2 output [H][W][C]; consts 8 W, 9 H, 10 C (multiple of 4); launch W * C / 4 x H
// SPDX-License-Identifier: GPL-3.0-only
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Half { f16vec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Args { uint64_t slot[8]; uint c[8]; uint grid[4]; };
layout(push_constant) uniform Push { Args a; } pc;
void main() {
    Args a = pc.a;
    const uint W = a.c[0], H = a.c[1], C4 = a.c[2] / 4u;   // threads: x = pixel * C4 + channel group, y = row
    const uint t = gl_GlobalInvocationID.x;
    const uint px = t / C4, g = t % C4, py = gl_GlobalInvocationID.y;
    if (px >= W || py >= H) return;
    Half src = Half(a.slot[0]), skip = Half(a.slot[1]), dst = Half(a.slot[2]);
    const uint Wi = W / 2u, Hi = H / 2u;
    const float fx = float(px) * 0.5 - 0.25, fy = float(py) * 0.5 - 0.25;
    const float x0f = floor(fx), y0f = floor(fy);
    const float tx = fx - x0f, ty = fy - y0f;
    const int x0 = int(x0f), y0 = int(y0f);
    const uint xa = uint(clamp(x0, 0, int(Wi) - 1)), xb = uint(clamp(x0 + 1, 0, int(Wi) - 1));
    const uint ya = uint(clamp(y0, 0, int(Hi) - 1)), yb = uint(clamp(y0 + 1, 0, int(Hi) - 1));
    const vec4 v00 = vec4(src.v[(ya * Wi + xa) * C4 + g]), v10 = vec4(src.v[(ya * Wi + xb) * C4 + g]);
    const vec4 v01 = vec4(src.v[(yb * Wi + xa) * C4 + g]), v11 = vec4(src.v[(yb * Wi + xb) * C4 + g]);
    const vec4 u = mix(mix(v00, v10, tx), mix(v01, v11, tx), ty);
    dst.v[(py * W + px) * C4 + g] = f16vec4(u + vec4(skip.v[(py * W + px) * C4 + g]));
}
